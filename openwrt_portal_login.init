#!/bin/sh /etc/rc.common
#
# portal_login v5 — 慧湖通门户自动认证
#
# 运行模式（/etc/portal_login.conf 的 [daemon] mode）：
#   daemon  默认：驻留并周期探测，断网自动重连，支持 SIGHUP 热重载
#   once    单次：开机只执行一次，随后退出；人工重连使用 reconnect
#
# 部署：
#   代码目录  /root/portal_login/（含 portal_login/ 与 tools/）
#   配置文件  /etc/portal_login.conf（INI，chmod 600）
#   手动命令  /usr/bin/reconnect（由 openwrt_reconnect.sh 安装）
#
START=99
USE_PROCD=1

PROG_DIR=/root/portal_login

start_service() {
	[ -x /usr/bin/python3 ] || { echo "python3 未安装：opkg install python3-light（24.10+ 用 apk add）"; return 1; }

	# 不用 shell source INI，避免把凭证当 shell 代码解析；无效值由 Config 回退为 daemon。
	MODE=$(PYTHONPATH="$PROG_DIR" /usr/bin/python3 -c 'from portal_login.config import Config; print(Config().MODE)' 2>/dev/null)
	[ "$MODE" = "once" ] || MODE=daemon

	procd_open_instance
	if [ "$MODE" = "once" ]; then
		procd_set_param command /usr/bin/python3 -m portal_login once
		# 单次模式绝不能配置 respawn，否则退出后会被 procd 再次拉起，变成变相扫描。
	else
		procd_set_param command /usr/bin/python3 -m portal_login daemon
		# respawn 10 30 5：10 秒内退出视为异常；30 秒后重启；连续 5 次后放弃。
		procd_set_param respawn 10 30 5
	fi
	procd_set_param env PYTHONPATH="$PROG_DIR"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	# 仅 daemon 模式有进程可接收 HUP；once 模式没有驻留进程。
	# 修改 mode 本身需要 restart，不能用 reload 切换运行模式。
	procd_send_signal portal_login '*' HUP
}

status_service() {
	if pgrep -f "portal_login daemon" >/dev/null 2>&1; then
		echo "portal_login: daemon running"
	else
		echo "portal_login: no resident process（once 模式执行完毕或服务未运行）"
	fi
	PYTHONPATH="$PROG_DIR" /usr/bin/python3 -m portal_login status
}

# 配置是 INI，不是 UCI；修改间隔等 daemon 参数可 reload，修改 mode 必须 restart。
